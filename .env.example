# Colab LLM Station - Local Workstation Environment Configuration
# Copy this file to .env and configure your secrets

# Tailscale Auth Key (Required for headless private mesh networking)
# Generate a reusable, ephemeral key at: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-your-tailscale-key-here

# Hugging Face Access Token (Optional: Required only for gated models e.g. Llama-3)
HF_TOKEN=

# Default Hardware Acceleration for Colab VM (Options: A100, H100, L4, T4)
COLAB_GPU=A100

# Default Colab Session Name
COLAB_SESSION=colab-llm-station

# Default Inference Engine (Options: vllm, ollama)
STATION_ENGINE=vllm

# Default Model Identifier (Optional: Leave blank to use catalog recommendation)
# Examples:
# vLLM:   Qwen/Qwen2.5-Coder-32B-Instruct-AWQ
# Ollama: qwen3.8:27b
STATION_MODEL=
